[sub_resource type="GDScript" id="GDScript_rbjbf"]
script/source = "extends Area2D

class_name  TitleHover

@export var text: String

func _ready() -> void:
	$Label.text = text


func _on_mouse_entered() -> void:
	$Label.visible = true


func _on_mouse_exited() -> void:
	$Label.visible = false
"

